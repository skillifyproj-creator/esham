# Local backend origin; auth routes use /auth directly (no /api prefix).
VITE_API_BASE_URL=http://localhost:5206
# Enable only after the backend Google OAuth flow and cookie session endpoints are live.
VITE_GOOGLE_AUTH_ENABLED=false

# Show temporary demo admin navigation in a deployed preview (not authorization).
VITE_ADMIN_PREVIEW=false

# Production: authenticated same-origin gateway behind /ai (no keys here).
# Leave unset to use the same-origin Vite proxy during development.
VITE_ASSISTANT_API_URL=
VITE_VIDEO_REVIEW_API_URL=
# Deployment example: /ai/assistant and /ai respectively.

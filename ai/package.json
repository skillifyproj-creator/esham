{
  "name": "esham-video-review",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "assistant": "node --env-file-if-exists=.env src/assistant-server.mjs",
    "data:prepare": "python scripts/prepare_courses.py --download",
    "serve": "node --env-file-if-exists=.env src/gateway.mjs",
    "evaluate": "node --env-file-if-exists=.env scripts/evaluate.mjs"
  }
}

# Place these locations inside the existing HTTPS server for the website.
# Provider keys remain in the AI container environment; never in this file or Vite.
location /ai/ {
    client_max_body_size 21m;
    proxy_pass http://127.0.0.1:8088/;
    proxy_set_header Host $http_host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Cookie $http_cookie;
    proxy_read_timeout 140s;
    proxy_send_timeout 140s;
    proxy_request_buffering off;
}
# Route /auth/ and /me to the existing account backend on the same HTTPS origin
# using that backend's deployed address. Preserve Set-Cookie and Cookie.
# Keep the AI container port private (for example 127.0.0.1:8088:8080).

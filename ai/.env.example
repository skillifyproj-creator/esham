# Local development only. Copy to .env and fill the key locally; never commit it.
PORT=8000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
ASSISTANT_PORT=8001
CHAT_PROVIDER=google
# To use DeepSeek for chat only, set CHAT_PROVIDER=deepseek and its key below.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://localhost:5173

# Only for npm run serve / Docker; keep local assistant/start commands unchanged.
GATEWAY_PORT=8080
PUBLIC_ORIGIN=https://your-website.example
BACKEND_SESSION_URL=https://your-account-api.example/auth/session
# Optional operator-owned public course snapshot; never accept a browser catalog as authority.
PLATFORM_CATALOG_FILE=
# Set true only for HTTP on a private service network.
ALLOW_INTERNAL_HTTP=false
